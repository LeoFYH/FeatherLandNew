        \u043C\u0435\u0436\u0434\u0443 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432
        \u0432 \u043F\u043E\u0433\u043E\u043D\u0435 \u0437\u0430 \u0434\u043E\u0431\u044B\u0447\u0435\u0439.
        \u0415\u043C\u0443 \u043F\u0440\u0438\u0441\u0443\u0449\u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
        \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E
        \u0438 \u043D\u0435\u0443\u043A\u0440\u043E\u0442\u0438\u043C\u044B\u0439
        \u0434\u0443\u0445 \u043B\u0435\u0441\u043E\u0432."
