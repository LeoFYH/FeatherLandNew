      Data: 4881|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041E\u0434\u043D\u0430 \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445
        \u043F\u0442\u0438\u0446, \u0447\u0442\u043E \u043A\u0440\u0443\u0433\u043B\u044B\u0439
        \u0433\u043E\u0434 \u0436\u0438\u0432\u0443\u0442 \u0432 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
        \u0448\u0438\u0440\u043E\u0442\u0430\u0445 \u0410\u0440\u043A\u0442\u0438\u043A\u0438.
        \u0415\u0435 \u0431\u0435\u043B\u043E\u0441\u043D\u0435\u0436\u043D\u043E\u0435
        \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435 \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043C\u043E\u0440\u0441\u043A\u0438\u043C\u0438 \u043B\u044C\u0434\u0430\u043C\u0438,
        \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
        \u0441\u043D\u043E\u0432\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438
        \u0431\u0435\u043B\u044B\u0445 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439
        \u0438 \u0442\u044E\u043B\u0435\u043D\u0435\u0439."
