      Data: 4408|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043F\u0435\u0432\u0447\u0430\u044F
        \u043F\u0442\u0430\u0448\u043A\u0430 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0433\u043E
        \u0432 \u043A\u0440\u0430\u043F\u0438\u043D\u043A\u0443 \u043E\u043A\u0440\u0430\u0441\u0430
        \u0440\u043E\u0434\u043E\u043C \u0438\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u0438.
        \u041E\u043D\u0430 \u043B\u044E\u0431\u0438\u0442 \u043F\u0435\u0442\u044C
        \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441\u0440\u0435\u0434\u0438
        \u0438\u0441\u0441\u0443\u0448\u0435\u043D\u043D\u044B\u0445 \u0441\u043A\u0430\u043B
        \u0438 \u043A\u0443\u0441\u0442\u043E\u0432, \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C\u044E
        \u0438 \u0433\u0440\u0430\u0446\u0438\u043E\u0437\u043D\u043E\u0441\u0442\u044C\u044E
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044F
        \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u043E \u0436\u0438\u0437\u043D\u0438
        \u0434\u0430\u0436\u0435 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0445
        \u0437\u0435\u043C\u043B\u044F\u0445."
