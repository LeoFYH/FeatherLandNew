      Data: 4417|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0441\u0442\u0435\u043F\u043D\u0430\u044F
        \u043F\u0442\u0438\u0446\u0430 \u0441 \u043F\u0435\u0441\u0447\u0430\u043D\u043E\u0433\u043E
        \u0446\u0432\u0435\u0442\u0430 \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C
        \u2014 \u043F\u043E\u0434 \u0441\u0442\u0430\u0442\u044C \u0441\u0432\u043E\u0435\u043C\u0443
        \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044E. \u041E\u043D\u0430
        \u0441\u043B\u044B\u0432\u0435\u0442 \u0441\u0432\u043E\u0438\u043C \u0438\u0437\u044F\u0449\u043D\u044B\u043C
        \u0431\u0440\u0430\u0447\u043D\u044B\u043C \u0442\u0430\u043D\u0446\u0435\u043C,
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u043C
        \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435, \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E\u0441\u0442\u044C
        \u0438 \u0442\u0438\u0445\u0438\u0439 \u0440\u0438\u0442\u043C \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0433\u043E
        \u0432\u0435\u0442\u0440\u0430."
