    - Name: text
      Entry: 1
      Data: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0430\u044F \u043F\u0442\u0438\u0446\u0430,
        \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0449\u0430\u044F\u0441\u044F
        \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u0445.
        \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
        \u043E\u043D\u0430 \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
        \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439 \u0441\u0433\u043E\u0440\u0430\u0435\u0442
        \u0434\u043E\u0442\u043B\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F
        \u0438\u0437 \u043F\u0435\u043F\u043B\u0430, \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044F
        \u0432\u0435\u0447\u043D\u0443\u044E \u043D\u0430\u0434\u0435\u0436\u0434\u0443
        \u0438 \u043A\u0440\u0443\u0433\u043E\u0432\u043E\u0440\u043E\u0442 \u0436\u0438\u0437\u043D\u0438."
