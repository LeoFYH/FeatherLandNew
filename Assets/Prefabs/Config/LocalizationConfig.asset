      Data: 4413|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0438\u0437\u044F\u0449\u043D\u0430\u044F
        \u043F\u0442\u0438\u0446\u0430 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C
        \u043E\u0441\u0442\u0440\u044B\u043C \u0445\u0432\u043E\u0441\u0442\u043E\u043C
        \u0438 \u043C\u044F\u0433\u043A\u0438\u043C \u0432\u043E\u0440\u043A\u043E\u0432\u0430\u043D\u0438\u0435\u043C,
        \u043E\u0431\u0438\u0442\u0430\u044E\u0449\u0430\u044F \u043D\u0430 \u0436\u0430\u0440\u043A\u0438\u0445
        \u0437\u0430\u0441\u0443\u0448\u043B\u0438\u0432\u044B\u0445 \u0440\u0430\u0432\u043D\u0438\u043D\u0430\u0445.
        \u0415\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F \u0433\u0440\u0430\u0446\u0438\u044F
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442
        \u043C\u0438\u0440 \u0438 \u0436\u0438\u0437\u043D\u0435\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C
        \u043F\u043E\u0434 \u043F\u0430\u043B\u044F\u0449\u0438\u043C \u0441\u043E\u043B\u043D\u0446\u0435\u043C."
