        \u0440\u0435\u0433\u0438\u043E\u043D\u043E\u0432. \u0417\u0438\u043C\u043E\u0439
        \u043E\u043D\u0438 \u043C\u0435\u043D\u044F\u044E\u0442 \u0441\u0432\u043E\u0435
        \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0435 \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435
        \u043D\u0430 \u0431\u0435\u043B\u043E\u0435, \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E
        \u0441\u043B\u0438\u0432\u0430\u044F\u0441\u044C \u0441 \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C.
        \u042D\u0442\u0438 \u0442\u0438\u0445\u0438\u0435 \u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u044B\u0435
        \u043F\u0442\u0438\u0446\u044B \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442
        \u0441\u0438\u043B\u0443 \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u043D\u0430
        \u0437\u0430\u0441\u043D\u0435\u0436\u0435\u043D\u043D\u044B\u0445 \u0440\u0430\u0432\u043D\u0438\u043D\u0430\u0445."
