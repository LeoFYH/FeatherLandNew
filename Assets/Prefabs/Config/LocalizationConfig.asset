      Data: 4345|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0416\u0435\u043B\u0442\u044B\u0439 \u0445\u043E\u0445\u043E\u043B\u043E\u043A
        \u044D\u0442\u0438\u0445 \u043B\u0435\u0441\u043D\u044B\u0445 \u043A\u0440\u0430\u0441\u0430\u0432\u0446\u0435\u0432
        \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E
        \u043A\u043E\u0440\u043E\u043D\u0443. \u041E\u043D\u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u043E
        \u043F\u0440\u0438\u0440\u0443\u0447\u0430\u044E\u0442\u0441\u044F \u0438
        \u0434\u0430\u0436\u0435 \u0443\u0447\u0430\u0442\u0441\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
        \u0442\u0430\u043A \u0447\u0442\u043E \u0438\u0437 \u043D\u0438\u0445 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
        \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u043F\u0438\u0442\u043E\u043C\u0446\u044B."
    - Name: 
