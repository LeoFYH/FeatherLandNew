    - Name: $v
      Entry: 7
      Data: 4349|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041B\u044E\u0431\u0438\u0442\u0435\u043B\u044C \u0446\u0432\u0435\u0442\u043E\u0447\u043D\u043E\u0433\u043E
        \u043D\u0435\u043A\u0442\u0430\u0440\u0430 \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u043C
        \u044F\u0437\u044B\u043A\u043E\u043C-\u0449\u0435\u0442\u043E\u0447\u043A\u043E\u0439,
        \u043F\u0435\u0440\u044C\u044F\u043C\u0438 \u0441 \u043E\u0442\u043B\u0438\u0432\u043E\u043C
