    - Name: $v
      Entry: 7
      Data: 4409|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u042D\u0442\u0430 \u043F\u0442\u0438\u0446\u0430 \u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u0430
        \u0441\u0432\u043E\u0438\u043C \u043A\u0440\u0443\u043F\u043D\u044B\u043C
        \u0436\u0435\u043B\u0442\u044B\u043C \u043A\u043B\u044E\u0432\u043E\u043C
        \u0438 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C.
        \u0418\u0445, \u0440\u044B\u0441\u043A\u0430\u044E\u0449\u0438\u0445 \u043F\u043E
        \u0441\u0430\u0432\u0430\u043D\u043D\u0435 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
        \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445, \u0447\u0430\u0441\u0442\u043E
        \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \xAB\u043B\u0435\u0442\u0430\u044E\u0449\u0438\u043C\u0438
        \u0431\u0430\u043D\u0430\u043D\u0430\u043C\u0438\xBB. \u0423\u043C\u043D\u044B\u0435
        \u0438 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u044B\u0435,
        \u043E\u043D\u0438 \u2014 \u0441\u0438\u043C\u0432\u043E\u043B \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438
        \u0438 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u043C\u0430."
