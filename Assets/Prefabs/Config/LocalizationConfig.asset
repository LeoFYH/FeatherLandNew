      Data: 4407|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041C\u0430\u0442\u0435\u0440\u044B\u0439 \u0433\u043E\u0440\u043D\u044B\u0439
        \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A \u0441 \u0443\u043C\u0443\u0434\u0440\u0435\u043D\u043D\u044B\u043C
        \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C, \u0432\u044B\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439
        \u043D\u0430 \u0441\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0445 \u0443\u0442\u0435\u0441\u0430\u0445,
        \u043E\u0431\u0433\u043B\u0430\u0434\u044B\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u0438."
