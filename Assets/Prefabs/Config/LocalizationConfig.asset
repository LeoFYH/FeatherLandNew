    - Name: sprite
      Entry: 6
      Data: 
    - Name: text
      Entry: 1
      Data: "\u76EE\u524D\u6E38\u620F\u4ECD\u5728\u5F00\u53D1\u4E2D\uFF0C\u53EF\u80FD\u4F1A\u9047\u5230\u4E00\u4E9B\u5C0F\u95EE\u9898\u6216\u5C1A\u672A\u5B8C\u5584\u7684\u5185\u5BB9\uFF0C\u611F\u8C22\u4F60\u7684\u7406\u89E3\u4E0E\u652F\u6301\u3002 
        \u4F60\u7684\u6BCF\u4E00\u6B21\u70B9\u51FB\u4E0E\u53CD\u9988\uFF0C\u90FD\u662F\u8BA9\u8FD9\u7247\u68EE\u6797\u53D8\u5F97\u66F4\u7F8E\u597D\u7684\u52A8\u529B\u3002 
        \u5E0C\u671B\u4F60\u5728\u63A2\u7D22\u548C\u966A\u4F34\u9E1F\u5B9D\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u83B7\u5F97\u4E86\u4E00\u6BB5\u6E29\u67D4\u7684\u65F6\u5149\u548C\u7247\u523B\u7684\u5B81\u9759\u3002 
        \u6211\u4EEC\u4F1A\u6301\u7EED\u6253\u78E8\u8FD9\u6B3E\u6E38\u620F\uFF0C\u6B22\u8FCE\u4F60\u4ECA\u540E\u518D\u6B21\u56DE\u5230\u68EE\u6797\u770B\u770B\u3002 
        \u5982\u679C\u4F60\u559C\u6B22\u300A\u9E1F\u8BED\u68EE\u6797\u300B\uFF0C\u4E5F\u6B22\u8FCE\u5C06\u5B83\u52A0\u5165
        Steam \u613F\u671B\u5355\uFF0C\u6E38\u620F\u4E0A\u7EBF\u65F6\u5373\u53EF\u7B2C\u4E00\u65F6\u95F4\u6536\u5230\u901A\u77E5\u3002"
