        \u043D\u0430 \u043F\u043B\u044F\u0448\u0443\u0449\u0438\u0435 \u0441\u043D\u0435\u0436\u0438\u043D\u043A\u0438.
        \u042D\u0442\u0438 \u043A\u0440\u043E\u0442\u043A\u0438\u0435 \u0441\u0442\u0430\u0439\u043D\u044B\u0435
        \u043F\u0442\u0438\u0446\u044B \u043E\u0442\u043B\u0438\u0447\u043D\u043E
        \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u0440\u043E\u043B\u044C
        \u0441\u0438\u043C\u0432\u043E\u043B\u0430 \u0447\u0438\u0441\u0442\u043E\u0442\u044B
        \u0438 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0434
