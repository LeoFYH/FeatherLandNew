    - Name: $v
      Entry: 7
      Data: 865|BirdGame.Pattern, Assembly-CSharp
    - Name: sprite
      Entry: 6
      Data: 
    - Name: text
      Entry: 1
      Data: "Le kakapo est un perroquet nocturne et volant de Nouvelle-Z\xE9lande.
        En danger critique, il poss\xE8de un corps lourd, vert mousse et un visage
        caract\xE9ristique \xE0 saveur d'hurleur."
    - Name: 
      Entry: 8
      Data: 
    - Name: 
      Entry: 8
      Data: 
    - Name: 
      Entry: 7
      Data: 
    - Name: $k
      Entry: 1
