    - Name: $v
      Entry: 7
      Data: 4414|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0421\u043C\u0435\u043B\u0430\u044F \u0438 \u0443\u043C\u043D\u0430\u044F
        \u043F\u0442\u0438\u0446\u0430 \u0441 \u043B\u043E\u0441\u043D\u044F\u0449\u0438\u043C\u0438\u0441\u044F
        \u0447\u0435\u0440\u043D\u044B\u043C\u0438 \u043F\u0435\u0440\u044B\u0448\u043A\u0430\u043C\u0438
        \u0438 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C \u0432\u043E\u0440\u043E\u0442\u043D\u0438\u0447\u043A\u043E\u043C.
        \u041C\u0430\u043B\u043E \u043A\u0442\u043E \u043C\u043E\u0436\u0435\u0442
        \u0432\u044B\u0436\u0438\u0442\u044C \u0442\u0430\u043C, \u0433\u0434\u0435
        \u043E\u043D\u0430 \u043E\u0431\u0438\u0442\u0430\u0435\u0442. \u042D\u0442\u0430
        \u043C\u0430\u0442\u0435\u0440\u0430\u044F \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u0430\u044F
        \u043F\u043B\u0443\u0442\u043E\u0432\u043A\u0430 \u0441\u043B\u0430\u0432\u0438\u0442\u0441\u044F
        \u0441\u0432\u043E\u0435\u0439 \u043D\u0430\u0445\u043E\u0434\u0447\u0438\u0432\u043E\u0441\u0442\u044C\u044E
        \u0438 \u0438\u0433\u0440\u0438\u0432\u043E\u0441\u0442\u044C\u044E."
