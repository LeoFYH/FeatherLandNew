        \u043C\u0435\u0445\u043E\u043C \u0438 \u043F\u0438\u0442\u0430\u043D\u0438\u0435\u043C
        \u043C\u0435\u0434\u043E\u043C \u0438 \u0444\u0440\u0443\u043A\u0442\u0430\u043C\u0438.
        \u041E\u0447\u0435\u043D\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u044B
        \u0438 \u0448\u0443\u043C\u043D\u044B, \u043E\u043D\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
