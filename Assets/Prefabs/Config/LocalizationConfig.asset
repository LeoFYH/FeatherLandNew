    - Name: $v
      Entry: 7
      Data: 4348|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041F\u0443\u0445\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043D\u043E\u0447\u043D\u043E\u0439
        \u0433\u0443\u043B\u044F\u043A\u0430 \u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0432 \u043C\u0438\u0440\u0435 \u043F\u043E\u043F\u0443\u0433\u0430\u0439,
        \u043D\u0435 \u0443\u043C\u0435\u044E\u0449\u0438\u0439 \u043B\u0435\u0442\u0430\u0442\u044C.
        \u041D\u0435\u0443\u043A\u043B\u044E\u0436\u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0434\u0430\u0435\u0442
        \u0435\u043C\u0443 \u043E\u0441\u043E\u0431\u043E\u0435 \u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435,
        \u043F\u043E\u0431\u0443\u0436\u0434\u0430\u044F \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C
        \u0435\u0433\u043E \u0435\u0449\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0439."
