      Data: 4346|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439 \u043C\u0438\u043B\u0430\u0448,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u044E\u0431\u0438\u0442
        \u0432\u0435\u0441\u0435\u043B\u043E \u0447\u0438\u0440\u0438\u043A\u0430\u0442\u044C
        \u0432 \u0441\u0442\u0430\u0435 \u0434\u0440\u0443\u0437\u0435\u0439. \u041E\u0434\u0438\u043D
        \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0445
        \u043F\u0438\u0442\u043E\u043C\u0446\u0435\u0432 \u0441\u0440\u0435\u0434\u0438
        \u043F\u0442\u0438\u0446."
