    - Name: $v
      Entry: 7
      Data: 4410|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0421\u043C\u044B\u0448\u043B\u0435\u043D\u044B\u0439 \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A
        \u0441 \u0431\u0435\u043B\u044B\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C
        \u0438 \u043E\u0441\u0442\u0440\u044B\u043C \u0445\u043E\u0445\u043E\u043B\u043A\u043E\u043C.
        \u042D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445
        \u043F\u0442\u0438\u0446, \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0445\u0441\u044F
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438,
        \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044C
        \u044F\u0439\u0446\u0430. \u0412 \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0438
        \u0438\u0445 \u043F\u043E\u0447\u0438\u0442\u0430\u043B\u0438 \u043A\u0430\u043A
        \u0441\u0438\u043C\u0432\u043E\u043B \u0447\u0438\u0441\u0442\u043E\u0442\u044B
        \u0438 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438."
