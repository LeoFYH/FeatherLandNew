      Data: 4416|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0425\u043E\u0442\u044C \u044D\u0442\u043E\u0442 \u0433\u0440\u043E\u043C\u0430\u0434\u043D\u044B\u0439
        \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u0431\u0435\u0433\u0443\u043D
        \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043B\u0435\u0442\u0430\u0442\u044C,
        \u044D\u0442\u043E \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442 \u0435\u043C\u0443
        \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C. \u0414\u043B\u0438\u043D\u043D\u044B\u0435
        \u043D\u043E\u0433\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
        \u0435\u043C\u0443 \u0441 \u043B\u0435\u0433\u043A\u043E\u0441\u0442\u044C\u044E
        \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043D\u0447\u0430\u0435\u043C\u044B\u0435
        \u0434\u044E\u043D\u044B, \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044F
        \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0438
        \u0436\u0438\u0432\u0443\u0447\u0435\u0441\u0442\u044C."
