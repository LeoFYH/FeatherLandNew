      Data: 4411|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0412\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u0445\u043E\u0442\u043D\u0438\u043A
        \u0441 \u044F\u043D\u0442\u0430\u0440\u043D\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
        \u0438 \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C \u043F\u0435\u0441\u043E\u0447\u043D\u043E\u0433\u043E
        \u0446\u0432\u0435\u0442\u0430, \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u043C
        \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0439 \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u043E\u0439
        \u043D\u0430 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0445 \u0443\u0442\u0435\u0441\u0430\u0445.
        \u0413\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043A\u0440\u0438\u043A
        \u044D\u0442\u043E\u0439 \u043F\u0442\u0438\u0446\u044B \u0432 \u043D\u043E\u0447\u0438
        \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442
        \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u0443\u044E \u0438 \u043D\u0435\u0437\u0440\u0438\u043C\u0443\u044E
        \u0441\u0438\u043B\u0443."
