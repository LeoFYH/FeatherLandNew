      Data: 4415|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u0411\u0440\u043E\u0434\u044F\u0433\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445
        \u043F\u0443\u0441\u0442\u044B\u043D\u044C \u0441 \u043F\u0435\u0441\u0442\u0440\u044B\u043C
        \u0447\u0435\u0440\u043D\u043E-\u0431\u0435\u043B\u044B\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C
        \u0438 \u044F\u0440\u043A\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u043C
        \u043A\u043B\u044E\u0432\u043E\u043C. \u042D\u0442\u0430 \u043F\u0442\u0438\u0446\u0430
        \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043C\u043E\u043B\u043B\u044E\u0441\u043A\u0430\u043C\u0438
        \u0441 \u0437\u0430\u043B\u0438\u0442\u044B\u0445 \u0441\u043E\u043B\u043D\u0446\u0435\u043C
        \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u0438\u0439, \u043E\u043B\u0438\u0446\u0435\u0442\u0432\u043E\u0440\u044F\u044F
        \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u044F\u0435\u043C\u043E\u0441\u0442\u044C
        \u0438 \u0442\u043E\u0447\u043D\u044B\u0439 \u0440\u0430\u0441\u0447\u0435\u0442."
