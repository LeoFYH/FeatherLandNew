      Data: 4412|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041A\u0440\u043E\u0442\u043A\u0438\u0439 \u0432\u044C\u044E\u0440\u043E\u043A
        \u0441 \u043F\u0435\u0440\u0441\u0438\u043A\u043E\u0432\u044B\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C
        \u0438 \u043D\u0435\u0436\u043D\u044B\u043C \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u043C
        \u0433\u043E\u043B\u043E\u0441\u043A\u043E\u043C. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
        \u0441\u0442\u0430\u0439\u043A\u0430\u043C\u0438 \u043E\u043D\u0438 \u043F\u043E\u0440\u0445\u0430\u044E\u0442
        \u043F\u0440\u043E\u043C\u0435\u0436 \u0441\u0443\u0445\u0438\u0445 \u043A\u0443\u0441\u0442\u043E\u0432,
        \u043D\u0430\u0445\u043E\u0434\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u0443
        \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u0439
        \u043F\u0443\u0441\u0442\u044B\u043D\u0438."
