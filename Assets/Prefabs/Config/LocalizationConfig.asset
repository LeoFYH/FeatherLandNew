    - Name: $k
      Entry: 1
      Data: "Haast\u2019s EagleDescription"
    - Name: $v
      Entry: 7
      Data: 4405|BirdGame.Pattern, Assembly-CSharp
    - Name: text
      Entry: 1
      Data: "\u041D\u0435\u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u0431\u044B\u043B
        \u0441\u0430\u043C\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
        \u0432\u0438\u0434 \u043E\u0440\u043B\u043E\u0432 \u0438\u0437 \u041D\u043E\u0432\u043E\u0439
        \u0417\u0435\u043B\u0430\u043D\u0434\u0438\u0438: \u0440\u0430\u0437\u043C\u0430\u0445
        \u0438\u0445 \u043A\u0440\u044B\u043B\u044C\u0435\u0432 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u043B
        \u0442\u0440\u0435\u0445 \u043C\u0435\u0442\u0440\u043E\u0432. \u0421\u0432\u043E\u0438\u043C\u0438
        \u0442\u0438\u0433\u0440\u0438\u043D\u044B\u043C\u0438 \u043A\u043E\u0433\u0442\u044F\u043C\u0438
        \u043E\u043D\u0438 \u0445\u0432\u0430\u0442\u0430\u043B\u0438 \u043F\u0442\u0438\u0446
        \u043C\u043E\u0430. \u041E\u043D\u0438 \u0432\u044B\u043C\u0435\u0440\u043B\u0438,
        \u043D\u043E \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
        \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C \u0432\u0435\u043B\u0438\u0447\u0438\u044F
        \u0438 \u043F\u0435\u0440\u0432\u043E\u0431\u044B\u0442\u043D\u043E\u0439
        \u0441\u0438\u043B\u044B."
